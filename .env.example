# Copy to .env.local for local development.
#
# Both values are safe to expose: the anon key is designed to be public and is
# inert without a login (RLS requires an authenticated user). They end up in the
# built JS bundle either way. They are kept in GitHub Actions secrets for the
# deploy purely for tidiness, not for security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
